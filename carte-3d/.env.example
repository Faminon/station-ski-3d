# Copier ce fichier en .env.local et remplir les valeurs.

# Adresse du site de recherche AltiStay : liens « AltiStay » et « Fiche station » de la carte.
# Facultatif : sans elle, la carte fonctionne seule et n'affiche pas ces liens.
NEXT_PUBLIC_SEARCH_SITE_URL=http://localhost:3000

# ---- Conditions en direct (/api/live/<domaine>, src/lib/live) -------------------------------
# Toutes facultatives : sans elles, la carte affiche ce qu'elle peut et le dit.

# Météo-France, portail des API (https://portail-api.meteofrance.fr) : bulletin avalanche
# (« Bulletins de risque d'avalanche ») et vigilance (« Bulletin Vigilance »). Gratuit : créer un
# compte, s'abonner aux deux API, puis générer une clé d'API (« API Key ») pour l'application.
# Sans clé : pas de bulletin avalanche (lien vers Météo-France), vigilance relayée par MeteoAlarm.
METEOFRANCE_API_KEY=

# Open-Meteo (prévisions) : gratuit sans clé pour un usage NON commercial. Pour un usage
# commercial, abonnement Open-Meteo : la clé bascule sur leur API client.
OPEN_METEO_API_KEY=
